# Logging
LOG_LEVEL=info
# Human-readable logs for local development (JSON otherwise)
LOG_PRETTY=false

# OAuth2 authorization server (client credentials grant)
AUTH_ISSUER=http://auth:4000
AUTH_AUDIENCE=shoplab-services
AUTH_JWKS_URL=http://auth:4000/.well-known/jwks.json
TOKEN_TTL_SECONDS=300
# Credentials of the BFF (machine-to-machine client). Change them outside local dev!
BFF_CLIENT_ID=commerce-bff
BFF_CLIENT_SECRET=dev-bff-secret
# Back-office client, allowed to update prices and stock (demo of cache invalidation)
BACKOFFICE_CLIENT_ID=backoffice
BACKOFFICE_CLIENT_SECRET=dev-backoffice-secret

# BFF
PORT=3000
AUTH_TOKEN_URL=http://auth:4000/oauth/token
CATALOG_URL=http://catalog:4001
PRICING_URL=http://pricing:4002
INVENTORY_URL=http://inventory:4003

# Resilience (BFF -> services)
UPSTREAM_TIMEOUT_MS=800
UPSTREAM_RETRIES=2
UPSTREAM_RETRY_BASE_DELAY_MS=50
UPSTREAM_RETRY_MAX_DELAY_MS=500
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_MS=10000

# Chaos (simulated services): random latency in [min, max] ms and error rate in [0, 1]
CHAOS_LATENCY_MIN_MS=10
CHAOS_LATENCY_MAX_MS=40
CHAOS_ERROR_RATE=0.02

# Redis (cache, carts, rate-limit counters, change events)
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=bff:
CACHE_TTL_PRODUCT_SECONDS=600
CACHE_TTL_PRICE_SECONDS=60
CACHE_TTL_STOCK_SECONDS=10

# Rate limiting (per client IP, shared across BFF instances via Redis)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
